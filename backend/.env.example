APP_ENV=development
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://scenario:change-me@postgres:5432/scenario_forge
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
MINIO_SECURE=false
MINIO_BUCKET_ARTIFACTS=scenario-forge-artifacts
WORKER_SERVICE_TOKEN=replace-with-a-long-worker-secret
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=
EMBEDDING_DIM=768
CORS_ORIGINS=http://localhost:3000
INITIAL_ADMIN_EMAIL=admin@example.com
# Set only in local shell/secret manager; do not commit a real password.
INITIAL_ADMIN_PASSWORD=change-me-before-seeding
