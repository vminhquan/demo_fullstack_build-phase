DB_PASSWORD=change-me-with-a-long-random-password
POSTGRES_HOST_PORT=5432
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
WORKER_SERVICE_TOKEN=replace-with-a-long-random-worker-secret
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=768
OPENAI_API_KEY=
EMBEDDING_REQUEST_TIMEOUT_SECONDS=15
RAG_DATA_SOURCE=postgres
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-before-seeding
INITIAL_PROJECT_NAME=Scenario Forge
INITIAL_PROJECT_CODE=DEFAULT
# Scenario-generation agent2. The Backend sends AGENT_API_KEY as X-API-Key; set the same value for both.
AGENT_API_KEY=replace-with-a-long-random-agent-secret
# OPENAI_API_KEY above is required by agent2 to parse prompts and propose maneuvers.
AGENT2_MODEL_NAME=gpt-4o-mini
